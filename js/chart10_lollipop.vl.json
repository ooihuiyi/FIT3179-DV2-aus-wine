{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Lollipop chart of average export value per litre in Australian dollars for 20 export markets in 2026, sorted from highest to lowest. Malaysia pays the most at $18.25, almost 5 times the $3.84 average. The nine highest-paying markets, shaded, are all in Asia; the United Kingdom, the largest market by volume, pays $1.77.",
  "title": {
    "text": [
      "Malaysia pays the most for Australian wine,",
      "almost 5 times the average per litre"
    ],
    "subtitle": [
      "Average export value per litre (Australian dollars), 20 markets,",
      "year to June 2026."
    ]
  },
  "width": "container",
  "height": 440,
  "data": {
    "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/data/export_by_country.csv",
    "format": {
      "type": "csv",
      "parse": {
        "export_value_million_AUD": "number",
        "export_volume_million_litres": "number",
        "average_value_per_litre": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "2026",
      "as": "full_year"
    },
    {
      "lookup": "full_year",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/data/export_sales_historical.csv",
          "format": {
            "type": "csv",
            "parse": {
              "full_year": "number",
              "volume_million_litre": "number",
              "value_aud_million": "number"
            }
          }
        },
        "key": "full_year",
        "fields": [
          "volume_million_litre",
          "value_aud_million"
        ]
      }
    },
    {
      "calculate": "datum.value_aud_million / datum.volume_million_litre",
      "as": "national_avg"
    },
    {
      "calculate": "datum.destination_market == 'Mainland China' ? 'China' : datum.destination_market",
      "as": "market"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "price_rank"
        }
      ],
      "sort": [
        {
          "field": "average_value_per_litre",
          "order": "descending"
        }
      ]
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.price_rank <= 9"
        }
      ],
      "mark": {
        "type": "rect",
        "color": "#f0f0f0"
      },
      "encoding": {
        "y": {
          "field": "market",
          "type": "nominal",
          "sort": {
            "field": "average_value_per_litre",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "ticks": false,
            "domain": false,
            "labelColor": "#333",
            "labelFontSize": 11,
            "labelPadding": 6,
            "labelFontWeight": {
              "condition": {
                "test": "datum.value == 'United Kingdom' || datum.value == 'Malaysia'",
                "value": 700
              },
              "value": 400
            }
          },
          "scale": {
            "paddingInner": 0
          }
        },
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              20
            ]
          }
        },
        "x2": {
          "datum": 20
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "national_avg",
              "as": "avg"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#333",
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "avg",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              20
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "national_avg",
              "as": "avg"
            }
          ]
        },
        {
          "calculate": "'Average $' + format(datum.avg, '.2f')",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -30,
        "y": -8,
        "fontSize": 11,
        "color": "#333"
      },
      "encoding": {
        "x": {
          "field": "avg",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              20
            ]
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#e3cf94",
        "strokeWidth": 2.5
      },
      "encoding": {
        "y": {
          "field": "market",
          "type": "nominal",
          "sort": {
            "field": "average_value_per_litre",
            "order": "descending"
          },
          "title": null,
