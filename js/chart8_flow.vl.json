{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Flow map from Australia's centre to each market's centre, showing Australian wine exports to 20 markets in 2026. Line width shows export value. Mainland China is the largest market at $756 million, about a third of the value of these markets, followed by the United Kingdom and the United States.",
  "title": {
    "text": [
      "China buys a third of Australia's",
      "wine exports by value"
    ],
    "subtitle": [
      "Export value to 20 markets, 2026; wider = more dollars.",
      "Lines run between country centres. Darker = overlap."
    ]
  },
  "width": 640,
  "height": 330,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/js/world_countries.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ebebeb",
        "stroke": "white",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/data/export_by_country.csv",
        "format": {
          "type": "csv",
          "parse": {
            "export_value_million_AUD": "number",
            "export_volume_million_litres": "number",
            "average_value_per_litre": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "export_value_million_AUD",
              "as": "total"
            }
          ]
        },
        {
          "calculate": "datum.export_value_million_AUD / datum.total * 100",
          "as": "share"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "export_value_million_AUD",
              "order": "descending"
            }
          ]
        },
        {
          "calculate": "{'type': 'LineString', 'coordinates': [[133.78, -25.27], [datum.longitude, datum.latitude]]}",
          "as": "route"
        },
        {
          "calculate": "datum.destination_market == 'Mainland China' ? 'China' : datum.destination_market",
          "as": "label"
        },
        {
          "calculate": "[datum.label, '$' + format(datum.export_value_million_AUD, '.0f') + 'm']",
          "as": "label_lines"
        },
        {
          "calculate": "{'Mainland China': 108.9, 'United Kingdom': -20, 'Singapore': 58, 'Hong Kong': 141, 'United States': -95, 'Canada': -103, 'New Zealand': 176}[datum.destination_market]",
          "as": "tx"
        },
        {
          "calculate": "{'Mainland China': 43.5, 'United Kingdom': 73, 'Singapore': -12, 'Hong Kong': 15, 'United States': 39.8, 'Canada': 61, 'New Zealand': -41.5}[datum.destination_market]",
          "as": "ty"
        },
        {
          "calculate": "{'Mainland China': null, 'United Kingdom': -4, 'Singapore': 82, 'Hong Kong': 136, 'United States': null, 'Canada': null, 'New Zealand': null}[datum.destination_market]",
          "as": "lx"
        },
        {
          "calculate": "{'Mainland China': null, 'United Kingdom': 64, 'Singapore': -8, 'Hong Kong': 16, 'United States': null, 'Canada': null, 'New Zealand': null}[datum.destination_market]",
          "as": "ly"
        },
        {
          "calculate": "{'Mainland China': 'center', 'United Kingdom': 'left', 'Singapore': 'left', 'Hong Kong': 'left', 'United States': 'left', 'Canada': 'left', 'New Zealand': 'left'}[datum.destination_market]",
