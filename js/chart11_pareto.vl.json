{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Pareto chart of Australia's wine export value by market, year to June 2026: the 12 largest markets plus all other markets combined. China, the United Kingdom and the United States bring in 58% of export value, and the top 8 markets pass 80%.",
  "title": {
    "text": [
      "Three markets bring in 58% of",
      "Australia's wine export dollars"
    ],
    "subtitle": [
      "Share of export value by market (bars)",
      "and running total (line), year to June 2026."
    ]
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/data/export_by_country.csv",
    "format": {
      "type": "csv",
      "parse": {
        "export_value_million_AUD": "number",
        "average_value_per_litre": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "2026",
      "as": "full_year"
    },
    {
      "lookup": "full_year",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/data/export_sales_historical.csv",
          "format": {
            "type": "csv",
            "parse": {
              "full_year": "number",
              "value_aud_million": "number"
            }
          }
        },
        "key": "full_year",
        "fields": [
          "value_aud_million"
        ]
      }
    },
    {
      "calculate": "datum.export_value_million_AUD / datum.value_aud_million * 100",
      "as": "share"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "order"
        }
      ],
      "sort": [
        {
          "field": "export_value_million_AUD",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.order <= 12"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "share",
          "as": "top_share"
        }
      ]
    },
    {
      "calculate": "datum.order == 1 ? [0, 1] : [0]",
      "as": "part"
    },
    {
      "flatten": [
        "part"
      ]
    },
    {
      "calculate": "datum.part == 1 ? 'All other markets' : (datum.destination_market == 'Mainland China' ? 'China' : datum.destination_market)",
      "as": "market"
    },
    {
      "calculate": "datum.market",
      "as": "short"
    },
    {
      "calculate": "datum.part == 1 ? 100 - datum.top_share : datum.share",
      "as": "share"
    },
    {
      "calculate": "datum.part == 1 ? 99 : datum.order",
      "as": "order"
    },
    {
      "calculate": "datum.part == 1 ? null : datum.export_value_million_AUD",
      "as": "value_m"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "share",
          "as": "cum"
        }
      ],
      "sort": [
        {
          "field": "order"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.cum - datum.share",
      "as": "cum_before"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#bbbbbb",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "y": {
          "datum": 80,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
