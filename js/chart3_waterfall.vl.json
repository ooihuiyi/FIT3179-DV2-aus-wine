{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Horizontal waterfall. Tonnes lost per state (2025 minus 2026 crush) are computed from crush_by_state.csv, sorted largest first and stacked end to end; the grey bar is their sum.",
  "title": {
    "text": [
      "New South Wales, South Australia and Victoria",
      "lost 93% of the 306,334 tonnes"
    ],
    "subtitle": [
      "Tonnes of grapes lost by state, 2025 to 2026 vintage.",
      "Each bar starts where the previous state's ends.",
      "Bar colours match each state in the waffle chart."
    ]
  },
  "width": 460,
  "height": 250,
  "data": {
    "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/data/crush_by_state.csv"
  },
  "transform": [
    {
      "calculate": "datum.crush_2025_tonnes - datum.crush_2026_tonnes",
      "as": "lost"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "lost",
          "as": "total_lost"
        }
      ]
    },
    {
      "calculate": "datum.lost / datum.total_lost * 100",
      "as": "pct"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "window": [
            {
              "op": "sum",
              "field": "lost",
              "as": "end"
            },
            {
              "op": "row_number",
              "as": "order"
            },
            {
              "op": "lead",
              "field": "state_name",
              "as": "next"
            }
          ],
          "sort": [
            {
              "field": "lost",
              "order": "descending"
            }
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "calculate": "isValid(datum.next) ? datum.next : 'Total lost'",
          "as": "next"
        },
        {
          "calculate": "datum.state_name",
          "as": "label"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#999999",
        "strokeDash": [
          2,
          2
        ]
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative"
        },
        "y2": {
          "field": "next"
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "op": "min"
          },
          "title": null,
          "axis": {
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelColor": "#333",
            "labelPadding": 8
          }
        }
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "sum",
              "field": "lost",
              "as": "end"
            },
            {
              "op": "row_number",
              "as": "order"
            }
          ],
          "sort": [
            {
              "field": "lost",
              "order": "descending"
            }
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "calculate": "datum.end - datum.lost",
          "as": "start"
        },
        {
          "calculate": "datum.state_name",
          "as": "label"
        },
        {
          "calculate": "indexof(['South Australia', 'New South Wales', 'Victoria'], datum.state_name) >= 0 ? datum.state_name : 'WA, Tas and Qld'",
          "as": "group"
        }
      ],
      "mark": {
        "type": "bar",
        "height": 22,
        "stroke": "#b9b3dc",
        "strokeWidth": 0.6
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative",
          "title": "Tonnes lost",
          "axis": {
            "tickCount": 7,
            "grid": true,
            "gridColor": "#ececec",
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value / 1000, '.0f') + 'k'"
          }
        },
        "x2": {
          "field": "end"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "South Australia",
              "New South Wales",
              "Victoria",
              "WA, Tas and Qld"
            ],
            "range": [
              "#330163",
              "#7e609c",
              "#b7aed6",
              "#ebe8f5"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "crush_2025_tonnes",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Crush 2025 (tonnes)"
          },
          {
            "field": "crush_2026_tonnes",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Crush 2026 (tonnes)"
          },
          {
            "field": "lost",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Tonnes lost"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Share of national loss (%)"
          }
        ],
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "op": "min"
          },
          "title": null,
          "axis": {
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelColor": "#333",
            "labelPadding": 8
          }
        }
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "sum",
              "field": "lost",
              "as": "end"
            },
            {
              "op": "row_number",
              "as": "order"
            }
          ],
          "sort": [
            {
              "field": "lost",
              "order": "descending"
            }
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "calculate": "datum.state_name",
          "as": "label"
        },
        {
          "calculate": "format(datum.lost, ',') + (datum.pct < 1 ? ' (under 1%)' : ' (' + format(datum.pct, '.1f') + '%)')",
          "as": "value_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "color": "#333"
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "value_text"
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "op": "min"
          },
          "title": null,
          "axis": {
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelColor": "#333",
            "labelPadding": 8
          }
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "lost",
              "as": "lost"
            }
          ]
        },
        {
          "calculate": "'Total lost'",
          "as": "label"
        },
        {
          "calculate": "99",
          "as": "order"
        },
        {
          "calculate": "0",
          "as": "start"
        }
      ],
      "mark": {
        "type": "bar",
        "height": 22,
        "color": "#8a8a8a"
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative"
        },
        "x2": {
          "field": "lost"
        },
        "tooltip": [
          {
            "field": "lost",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Total tonnes lost"
          }
        ],
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "op": "min"
          },
          "title": null,
          "axis": {
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelColor": "#333",
            "labelPadding": 8
          }
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "lost",
              "as": "lost"
            }
          ]
        },
        {
          "calculate": "'Total lost'",
          "as": "label"
        },
        {
          "calculate": "99",
          "as": "order"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#333"
      },
      "encoding": {
        "x": {
          "field": "lost",
          "type": "quantitative"
        },
        "text": {
          "field": "lost",
          "type": "quantitative",
          "format": ","
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "op": "min"
          },
          "title": null,
          "axis": {
            "ticks": false,
            "domain": false,
            "labelFontSize": 12,
            "labelColor": "#333",
            "labelPadding": 8
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": [
              "Source: Wine Australia, National Vintage Report 2026,",
              "wineaustralia.com/market-insights/national-vintage-report"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "x": -120,
        "y": 300,
        "fontSize": 10,
        "color": "#666",
        "lineHeight": 13
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {}
}