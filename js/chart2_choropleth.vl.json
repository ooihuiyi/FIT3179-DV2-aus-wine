{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Tasmania's crush fell hardest, down 40%",
    "subtitle": "Fall in grape crush by state, 2025 to 2026 vintage."
  },
  "width": 450,
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/js/STE_2026_AUST_GDA2020.json",
    "format": {
      "type": "topojson",
      "feature": "aus_states"
    }
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "datum.properties.STE_NAME26 == 'Australian Capital Territory' ? 'ACT vineyards are counted in NSW (Canberra District)' : 'No wine data for ' + datum.properties.STE_NAME26",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "datum": "No wine data"
        },
        "tooltip": {
          "field": "note"
        }
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.STE_NAME26",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/data/crush_by_state.csv"
            },
            "key": "state_name",
            "fields": [
              "national_crush_share_2026",
              "crush_2025_tonnes",
              "crush_2026_tonnes",
              "percentage_change"
            ]
          }
        },
        {
          "filter": "isValid(datum.percentage_change)"
        },
        {
          "calculate": "-datum.percentage_change",
          "as": "fall"
        },
        {
          "calculate": "datum.fall >= 35 ? '35% or more' : datum.fall >= 25 ? '25 to under 35%' : datum.fall >= 15 ? '15 to under 25%' : 'Under 15%'",
          "as": "fall_class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "fall_class",
          "type": "ordinal",
          "title": "Fall in crush",
          "scale": {
            "domain": [
              "35% or more",
              "25 to under 35%",
              "15 to under 25%",
              "Under 15%",
              "No wine data"
            ],
            "range": [
              "#a63603",
              "#e6550d",
              "#fd8d3c",
              "#fdbe85",
              "#d9d9d9"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 0,
            "legendY": 360,
            "symbolType": "square",
            "symbolSize": 150,
            "symbolStrokeColor": "#bbbbbb",
            "symbolStrokeWidth": 0.5,
            "titleLimit": 200,
            "columns": 2,
            "columnPadding": 14,
            "rowPadding": 5
          }
        },
        "tooltip": [
          {
            "field": "properties.STE_NAME26",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "crush_2025_tonnes",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Crush 2025 (tonnes)"
          },
          {
            "field": "crush_2026_tonnes",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Crush 2026 (tonnes)"
          },
          {
            "field": "fall",
            "type": "quantitative",
            "format": ".1f",
            "title": "Fall from 2025 (%)"
          },
          {
            "field": "national_crush_share_2026",
            "type": "quantitative",
            "format": ".1f",
            "title": "Share of national crush (%)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 148.7,
            "lat": -42.3,
            "t": [
              "Tasmania: 18,845 to",
              "11,219 tonnes"
            ]
          },
          {
            "lon": 138.9,
            "lat": -21.0,
            "t": [
              "Queensland fell",
              "21%, but from",
              "only 620 tonnes"
            ]
          },
          {
            "lon": 131,
            "lat": -27.5,
            "t": [
              "South Australia,",
              "52% of grapes,",
              "fell only 12%"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "lineHeight": 14,
        "stroke": "white",
        "strokeWidth": 3,
        "strokeJoin": "round",
        "color": "white"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 148.7,
            "lat": -42.3,
            "t": [
              "Tasmania: 18,845 to",
              "11,219 tonnes"
            ]
          },
          {
            "lon": 138.9,
            "lat": -21.0,
            "t": [
              "Queensland fell",
              "21%, but from",
              "only 620 tonnes"
            ]
          },
          {
            "lon": 131.0,
            "lat": -27.5,
            "t": [
              "South Australia,",
              "52% of grapes,",
              "fell only 12%"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "lineHeight": 14,
        "color": "#1a1a1a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": [
              "Sources: Wine Australia, National Vintage Report 2026,",
              "wineaustralia.com/market-insights/national-vintage-report;",
              "ABS, ASGS Edition 4 state boundaries (2026), abs.gov.au.",
              "ACT included in NSW (Canberra District)."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "x": 0,
        "y": 445,
        "fontSize": 10,
        "color": "#666",
        "lineHeight": 13
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Urbanist, Helvetica Neue, Arial, sans-serif",
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleFont": "Urbanist, Helvetica Neue, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitlePadding": 4
    },
    "legend": {
      "titleFontSize": 12,
      "labelFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}