{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Waffle chart. Squares are generated from crush_by_state.csv: each group's share of the 2026 crush is rounded to whole percent and expanded into that many squares.",
  "title": {
    "text": ["South Australia crushes 52% of", "Australia's wine grapes"],
    "subtitle": [
      "Share of the national grape crush, 2026 vintage.",
      "One square = 1% of all grapes crushed."
    ]
  },
  "width": 260,
  "height": 260,
  "config": {
    "font": "Urbanist, Helvetica Neue, Arial, sans-serif",
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleFont": "Urbanist, Helvetica Neue, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitlePadding": 4
    },
    "legend": {"titleFontSize": 12, "labelFontSize": 12},
    "view": {"stroke": null}
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "indexof(['South Australia', 'New South Wales', 'Victoria'], datum.state_name) >= 0 ? datum.state_name : 'WA, Tas and Qld'",
          "as": "group"
        },
        {
          "aggregate": [
            {"op": "sum", "field": "crush_2026_tonnes", "as": "tonnes"}
          ],
          "groupby": ["group"]
        },
        {"joinaggregate": [{"op": "sum", "field": "tonnes", "as": "total"}]},
        {"calculate": "datum.tonnes / datum.total * 100", "as": "share"},
        {"calculate": "round(datum.share)", "as": "squares"},
        {
          "calculate": "indexof(['South Australia', 'New South Wales', 'Victoria', 'WA, Tas and Qld'], datum.group)",
          "as": "order"
        },
        {
          "calculate": "datum.group + ' (' + datum.squares + '%)'",
          "as": "label"
        },
        {"calculate": "sequence(0, datum.squares)", "as": "cell"},
        {"flatten": ["cell"]},
        {
          "window": [{"op": "row_number", "as": "position"}],
          "sort": [{"field": "order"}, {"field": "cell"}]
        },
        {"calculate": "(datum.position - 1) % 10", "as": "col"},
        {"calculate": "floor((datum.position - 1) / 10)", "as": "row"}
      ],
      "mark": {
        "type": "square",
        "size": 360,
        "opacity": 1,
        "stroke": "#b9b3dc",
        "strokeWidth": 0.6
      },
      "encoding": {
        "x": {"field": "col", "type": "ordinal", "axis": null},
        "y": {"field": "row", "type": "ordinal", "axis": null},
        "color": {
          "field": "label",
          "type": "nominal",
          "sort": {"field": "order"},
          "title": "State",
          "scale": {"range": ["#330163", "#7363a6", "#b7aed6", "#ebe8f5"]},
          "legend": {
            "orient": "right",
            "symbolType": "square",
            "symbolSize": 200,
            "symbolStrokeColor": "#b9b3dc",
            "symbolStrokeWidth": 0.6,
            "labelLimit": 220,
            "rowPadding": 8
          }
        },
        "tooltip": [
          {"field": "group", "type": "nominal", "title": "State"},
          {
            "field": "tonnes",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Crush 2026 (tonnes)"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1f",
            "title": "Share of national crush (%)"
          }
        ]
      },
      "data": {
        "url": "https://raw.githubusercontent.com/ooihuiyi/FIT3179-DV2-aus-wine/refs/heads/main/data/crush_by_state.csv"
      }
    },
    {
      "data": {
        "values": [
          {
            "t": [
              "Source: Wine Australia, National Vintage Report 2026,",
              "wineaustralia.com/market-insights/national-vintage-report"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "x": 0,
        "y": 280,
        "fontSize": 10,
        "color": "#666",
        "lineHeight": 13
      },
      "encoding": {"text": {"field": "t"}}
    }
  ]
}